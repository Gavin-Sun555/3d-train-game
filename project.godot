; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="3D train game"
config/description="Standalone 3D streetcar & monorail simulation."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")
boot_splash/bg_color=Color(0.05, 0.08, 0.12, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/app_icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://assets/app_icon.png"
config/macos_native_icon="res://assets/app_icon.icns"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true

[rendering]

scaling_3d/scale=0.85
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=1
environment/ssao/half_size=true
